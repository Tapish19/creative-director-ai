# Phase 1: Supabase project Settings > API. Both variables stay on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Older projects may use an anon key in SUPABASE_PUBLISHABLE_KEY. Never use service_role here.

# Phase 2 worker only. Never set this privileged key in the web hosting environment.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Phase 3 image worker only. Use the Workers AI token template (Read + Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Phase 4 voice worker. With no key, use real local speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Blank chooses windows on Windows, espeak elsewhere. Values: windows | espeak.
LOCAL_TTS_ENGINE=
# Optional executable path and installed voice name (e.g. en-us for eSpeak NG).
LOCAL_TTS_PATH=
LOCAL_TTS_VOICE=
# Phase 5 render worker. Native executables with libx264, AAC and libass.
# Windows also discovers workspace-local binaries installed under .tools/ffmpeg.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional worker-local music file: mono PCM16 WAV, 8-48 kHz, <=12 MiB.
RENDER_MUSIC_PATH=
# Phase 6 review worker. Reuses GEMINI_API_KEY/MODEL and Supabase worker credentials.
# 1-10, at most one decimal. Snapshotted on a generation's first review claim.
QUALITY_THRESHOLD=8
# Phase 7 review worker: 0 disables automatic revisions; hard maximum is 2.
# Snapshotted per cycle. Human script edits and scene changes use 0.
MAX_AUTOMATIC_REVISIONS=2
